{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=bloggingagent.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "BloggingAgent": "Information"
    }
  },
  "AllowedHosts": "*",
  "LlmSettings": {
    "DefaultProvider": "OpenAI",
    "OllamaEndpoint": "http://localhost:11434",
    "OllamaModel": "llama2",
    "MaxTokens": 1000,
    "Temperature": 0.7,
    "TimeoutSeconds": 30
  },
  "OpenAISettings": {
    "ApiKey": "",
    "Model": "gpt-3.5-turbo",
    "Organization": "",
    "MaxTokens": 1000,
    "Temperature": 0.7,
    "TimeoutSeconds": 30
  },
  "SeoSettings": {
    "MinTitleLength": 30,
    "MaxTitleLength": 60,
    "MinDescriptionLength": 120,
    "MaxDescriptionLength": 160,
    "MinContentLength": 300,
    "TargetKeywordDensity": 1.5,
    "AutoGenerateMetaDescription": true,
    "AutoOptimizeContent": true,
    "DefaultKeywords": ["blog", "article", "content"]
  },
  "CacheSettings": {
    "DefaultExpirationMinutes": 30,
    "BlogPostExpirationMinutes": 10,
    "AnalyticsExpirationMinutes": 15,
    "MemoryExpirationDays": 30,
    "EnableCaching": true,
    "MaxCacheSize": 1000,
    "CacheType": "Memory"
  },
  "AgentSettings": {
    "DefaultAuthor": "AI Assistant",
    "MaxPostLength": 5000,
    "DefaultTags": ["blog", "ai-generated"],
    "AutoPublish": false,
    "Theme": "default",
    "CustomSettings": {}
  }
}
