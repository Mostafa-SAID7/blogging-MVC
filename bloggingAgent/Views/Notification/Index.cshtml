@model List<Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container mt-5 mb-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="fas fa-bell me-2"></i>Notifications
            </h2>
            <p class="text-muted">View all your notifications and stay updated</p>
        </div>
        <div class="col-md-4 text-md-end">
            @if (Model?.Count > 0)
            {
                <button onclick="markAllAsRead()" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-check-double me-1"></i>Mark All as Read
                </button>
            }
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row">
            <div class="col-md-8">
                @foreach (var notification in Model.OrderByDescending(n => n.CreatedAt))
                {
                    <div class="card mb-3 shadow-sm @(notification.IsRead ? "border-light" : "border-primary")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div>
                                        @if (!notification.IsRead)
                                        {
                                            <span class="badge bg-primary me-2">New</span>
                                        }
                                        <h5 class="card-title d-inline">@notification.Title</h5>
                                    </div>
                                    <p class="card-text text-muted">@notification.Message</p>
                                    <small class="text-muted">
                                        <i class="fas fa-clock me-1"></i>@notification.CreatedAt.ToString("MMM dd, yyyy h:mm tt")
                                    </small>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (!notification.IsRead)
                                        {
                                            <li>
                                                <button class="dropdown-item" onclick="markAsRead(@notification.Id)">
                                                    <i class="fas fa-check me-2"></i>Mark as Read
                                                </button>
                                            </li>
                                        }
                                        <li>
                                            <button class="dropdown-item" onclick="deleteNotification(@notification.Id)">
                                                <i class="fas fa-trash me-2"></i>Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(notification.ActionUrl))
                            {
                                <div class="mt-3">
                                    <a href="@notification.ActionUrl" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-arrow-right me-1"></i>View Details
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">
                            <i class="fas fa-filter me-2"></i>Notification Stats
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <small class="text-muted">Unread</small>
                            <p class="h4 text-primary mb-0">
                                @(Model?.Count(n => !n.IsRead) ?? 0)
                            </p>
                        </div>
                        <hr />
                        <div>
                            <small class="text-muted">Total</small>
                            <p class="h4 mb-0">
                                @(Model?.Count ?? 0)
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="alert alert-info text-center" role="alert">
                    <i class="fas fa-inbox" style="font-size: 48px; opacity: 0.5;"></i>
                    <h5 class="mt-3">No Notifications</h5>
                    <p class="text-muted">You're all caught up! Check back later for updates.</p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function markAsRead(notificationId) {
            fetch(`/Notification/MarkAsRead/${notificationId}`, {
                method: 'POST',
                headers: {
                    'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
        }

        function markAllAsRead() {
            fetch('/Notification/MarkAllAsRead', {
                method: 'POST',
                headers: {
                    'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
        }

        function deleteNotification(notificationId) {
            if (confirm('Are you sure you want to delete this notification?')) {
                fetch(`/Notification/Delete/${notificationId}`, {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    }
                });
            }
        }
    </script>
}
