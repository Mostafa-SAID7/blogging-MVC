                    @if (User.IsInRole("Author") || User.IsInRole("Editor") || User.IsInRole("Administrator"))
                    {
                        <div class="card mt-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fab fa-share-alt me-2"></i>Share on Social Media
                                </h5>
                            </div>
                            <div class="card-body">
                                <form method="post" action="@Url.Action("SharePost", "SocialMedia")">
                                    <input type="hidden" name="postId" value="@Model.Post.Id" />

                                    <div class="mb-3">
                                        <label class="form-label">Select Platforms:</label>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="platforms" value="Twitter" id="twitterCheck">
                                                    <label class="form-check-label" for="twitterCheck">
                                                        <i class="fab fa-twitter text-info me-1"></i>Twitter
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="platforms" value="LinkedIn" id="linkedinCheck">
                                                    <label class="form-check-label" for="linkedinCheck">
                                                        <i class="fab fa-linkedin text-primary me-1"></i>LinkedIn
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="platforms" value="Facebook" id="facebookCheck">
                                                    <label class="form-check-label" for="facebookCheck">
                                                        <i class="fab fa-facebook text-primary me-1"></i>Facebook
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="customMessage" class="form-label">Custom Message (optional):</label>
                                        <textarea class="form-control" id="customMessage" name="customMessage" rows="3"
                                                  placeholder="Add a custom message or leave blank to use default..."></textarea>
                                        <div class="form-text">If left blank, will use: "{post title} {post url}"</div>
                                    </div>

                                    <button type="submit" class="btn btn-primary">
                                        <i class="fab fa-share-alt me-2"></i>Share Now
                                    </button>
                                </form>
                            </div>
                        </div>
                    }