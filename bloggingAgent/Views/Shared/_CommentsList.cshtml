@model int

@using BloggingAgent.Data.Repositories
@using BloggingAgent.Models.Domain
@using Microsoft.AspNetCore.Mvc.Razor
@using Microsoft.Extensions.DependencyInjection

@{
    var commentRepository = ViewContext.HttpContext.RequestServices.GetService<IRepository<Comment>>();
    var userRepository = ViewContext.HttpContext.RequestServices.GetService<IRepository<User>>();
    var comments = await commentRepository.FindAsync(c => c.BlogPostId == Model && c.IsApproved && !c.IsSpam);
    var commentsList = comments.OrderByDescending(c => c.CreatedAt).ToList();
}

@if (commentsList.Any())
{
    <div class="comments-list">
        @foreach (var comment in commentsList)
        {
            <div class="comment mb-4 p-3 border rounded">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="comment-author">
                        <strong>@(comment.User?.FirstName + " " + comment.User?.LastName ?? "Anonymous")</strong>
                        <small class="text-muted ms-2">@comment.CreatedAt.ToRelativeTime()</small>
                    </div>
                    @if (User.IsInRole("Administrator") || User.IsInRole("Editor"))
                    {
                        <div class="comment-actions">
                            <form method="post" action="@Url.Action("MarkAsSpam", "Comment")" class="d-inline">
                                <input type="hidden" name="id" value="@comment.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Mark this comment as spam?')">
                                    <i class="fas fa-flag"></i>
                                </button>
                            </form>
                            <form method="post" action="@Url.Action("Delete", "Comment")" class="d-inline ms-1">
                                <input type="hidden" name="id" value="@comment.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this comment?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
                <div class="comment-content">
                    @Html.Raw(comment.Content.Replace("\n", "<br>"))
                </div>
                <div class="comment-footer mt-2">
                    <button class="btn btn-sm btn-link text-decoration-none p-0" onclick="toggleReplyForm(@comment.Id)">
                        <i class="fas fa-reply me-1"></i>Reply
                    </button>
                </div>

                <!-- Reply Form (hidden by default) -->
                <div id="reply-form-@comment.Id" class="reply-form mt-3" style="display: none;">
                    <form method="post" action="@Url.Action("Add", "Comment")">
                        <input type="hidden" name="postId" value="@Model" />
                        <input type="hidden" name="parentCommentId" value="@comment.Id" />
                        <div class="mb-2">
                            <textarea class="form-control form-control-sm" name="content" rows="2"
                                      placeholder="Write a reply..." required></textarea>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-sm btn-primary me-2">
                                <i class="fas fa-paper-plane me-1"></i>Reply
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    onclick="toggleReplyForm(@comment.Id)">
                                Cancel
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Nested Replies -->
                @if (comment.ParentCommentId == null)
                {
                    var replies = commentsList.Where(c => c.ParentCommentId == comment.Id).ToList();
                    if (replies.Any())
                    {
                        <div class="replies mt-3 ms-4 border-start">
                            @foreach (var reply in replies)
                            {
                                <div class="reply mb-3 p-2 bg-light rounded">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div class="reply-author">
                                            <strong>@(reply.User?.FirstName + " " + reply.User?.LastName ?? "Anonymous")</strong>
                                            <small class="text-muted ms-2">@reply.CreatedAt.ToRelativeTime()</small>
                                        </div>
                                    </div>
                                    <div class="reply-content">
                                        @Html.Raw(reply.Content.Replace("\n", "<br>"))
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-4">
        <i class="fas fa-comments fa-2x text-muted mb-3"></i>
        <p class="text-muted">No comments yet. Be the first to share your thoughts!</p>
    </div>
}

<script>
    function toggleReplyForm(commentId) {
        const form = document.getElementById(`reply-form-${commentId}`);
        if (form.style.display === 'none' || form.style.display === '') {
            form.style.display = 'block';
        } else {
            form.style.display = 'none';
        }
    }
</script>

@{
    async Task<int> GetCommentCountAsync(int postId)
    {
        var repository = ViewContext.HttpContext.RequestServices.GetService<IRepository<Comment>>();
        return await repository.CountAsync(c => c.BlogPostId == postId && c.IsApproved && !c.IsSpam);
    }
}