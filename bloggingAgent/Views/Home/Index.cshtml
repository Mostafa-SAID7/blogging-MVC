@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section bg-gradient-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">
                    AI-Powered Blogging <br>
                    <span class="text-warning">Made Simple</span>
                </h1>
                <p class="lead mb-4">
                    Create engaging, SEO-optimized blog content with the power of artificial intelligence.
                    From ideation to publication, streamline your blogging workflow.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    @if (Model.IsAuthenticated)
                    {
                        <a href="/Blog/Generate" class="btn btn-light btn-lg px-4">
                            <i class="fas fa-plus-circle me-2"></i>Create New Post
                        </a>
                        <a href="/Analytics" class="btn btn-outline-light btn-lg px-4">
                            <i class="fas fa-chart-line me-2"></i>View Analytics
                        </a>
                    }
                    else
                    {
                        <a href="/Auth/Register" class="btn btn-light btn-lg px-4">
                            <i class="fas fa-rocket me-2"></i>Get Started Free
                        </a>
                        <a href="/Features" class="btn btn-outline-light btn-lg px-4">
                            <i class="fas fa-star me-2"></i>Explore Features
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="hero-robot">
                    <i class="fas fa-robot fa-10x text-warning opacity-75"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Platform Stats Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3 mb-4">
                <div class="stat-card">
                    <i class="fas fa-file-alt fa-3x text-primary mb-3"></i>
                    <h3 class="fw-bold text-primary">@Model.PlatformStats.TotalPosts.ToString("N0")</h3>
                    <p class="text-muted mb-0">Blog Posts</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="stat-card">
                    <i class="fas fa-users fa-3x text-success mb-3"></i>
                    <h3 class="fw-bold text-success">@Model.PlatformStats.TotalUsers.ToString("N0")</h3>
                    <p class="text-muted mb-0">Active Users</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="stat-card">
                    <i class="fas fa-comments fa-3x text-info mb-3"></i>
                    <h3 class="fw-bold text-info">@Model.PlatformStats.TotalComments.ToString("N0")</h3>
                    <p class="text-muted mb-0">Comments</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="stat-card">
                    <i class="fas fa-eye fa-3x text-warning mb-3"></i>
                    <h3 class="fw-bold text-warning">@Model.PlatformStats.TotalViews.ToString("N0")</h3>
                    <p class="text-muted mb-0">Total Views</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-5 fw-bold mb-3">Why Choose BloggingAgent?</h2>
                <p class="lead text-muted">
                    Experience the future of content creation with our comprehensive AI-powered blogging platform.
                </p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4 border rounded-3 shadow-sm">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-brain fa-3x text-primary"></i>
                    </div>
                    <h5 class="fw-bold mb-3">AI Content Generation</h5>
                    <p class="text-muted">
                        Generate high-quality, engaging blog posts using advanced AI technology.
                        From topic research to final draft, let AI handle the heavy lifting.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4 border rounded-3 shadow-sm">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-search fa-3x text-success"></i>
                    </div>
                    <h5 class="fw-bold mb-3">SEO Optimization</h5>
                    <p class="text-muted">
                        Built-in SEO tools ensure your content ranks higher in search results.
                        Keyword research, meta tags, and optimization suggestions included.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4 border rounded-3 shadow-sm">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-share-alt fa-3x text-info"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Social Media Integration</h5>
                    <p class="text-muted">
                        Automatically share your content across multiple social media platforms.
                        Schedule posts and track engagement all in one place.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4 border rounded-3 shadow-sm">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-chart-line fa-3x text-warning"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Analytics Dashboard</h5>
                    <p class="text-muted">
                        Track your content performance with detailed analytics.
                        Monitor views, engagement, and SEO rankings in real-time.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4 border rounded-3 shadow-sm">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-users fa-3x text-danger"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Community Features</h5>
                    <p class="text-muted">
                        Build a community around your content with comments, likes, and user interactions.
                        Engage with readers and grow your audience.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4 border rounded-3 shadow-sm">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-clock fa-3x text-secondary"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Content Scheduling</h5>
                    <p class="text-muted">
                        Schedule your posts for optimal publishing times.
                        Maintain consistent content delivery without manual effort.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Posts Section -->
@if (Model.FeaturedPosts.Any())
{
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-8 mx-auto text-center">
                    <h2 class="display-5 fw-bold mb-3">Featured Posts</h2>
                    <p class="lead text-muted">
                        Discover our latest and most popular blog content
                    </p>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var post in Model.FeaturedPosts)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <span class="badge bg-primary me-2">@post.Tags.FirstOrDefault()</span>
                                    <small class="text-muted">@post.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                <h5 class="card-title fw-bold mb-3">
                                    <a href="/Blog/Details/@post.Slug" class="text-decoration-none text-dark">
                                        @post.Title
                                    </a>
                                </h5>
                                <p class="card-text text-muted mb-3">
                                    @if (!string.IsNullOrEmpty(post.Excerpt))
                                    {
                                        @(post.Excerpt.Length > 120 ? post.Excerpt.Substring(0, 120) + "..." : post.Excerpt)
                                    }
                                </p>
                                <div class="d-flex align-items-center">
                                    <small class="text-muted me-3">
                                        <i class="fas fa-user me-1"></i>@post.Author
                                    </small>
                                    <a href="/Blog/Details/@post.Slug" class="btn btn-sm btn-outline-primary">
                                        Read More
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="text-center mt-4">
                <a href="/Blog" class="btn btn-primary btn-lg">
                    <i class="fas fa-arrow-right me-2"></i>View All Posts
                </a>
            </div>
        </div>
    </section>
}

<!-- Popular Categories Section -->
@if (Model.PopularCategories.Any())
{
    <section class="py-5">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-8 mx-auto text-center">
                    <h2 class="display-5 fw-bold mb-3">Popular Categories</h2>
                    <p class="lead text-muted">
                        Explore content by topic and find what interests you most
                    </p>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var category in Model.PopularCategories)
                {
                    <div class="col-lg-2 col-md-4 col-sm-6">
                        <div class="category-card text-center p-3 border rounded-3 shadow-sm h-100">
                            <div class="category-icon mb-3">
                                <i class="fas fa-tag fa-2x text-primary"></i>
                            </div>
                            <h6 class="fw-bold mb-2">@category.Name</h6>
                            <small class="text-muted">@category.PostCount posts</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Recent Activity Section -->
@if (Model.RecentActivity.Any())
{
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-8 mx-auto text-center">
                    <h2 class="display-5 fw-bold mb-3">Recent Activity</h2>
                    <p class="lead text-muted">
                        Stay updated with the latest content and platform activity
                    </p>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="activity-timeline">
                        @foreach (var activity in Model.RecentActivity)
                        {
                            <div class="activity-item d-flex mb-4">
                                <div class="activity-icon me-3">
                                    <i class="fas fa-circle text-primary"></i>
                                </div>
                                <div class="activity-content flex-grow-1">
                                    <h6 class="mb-1">@activity.Title</h6>
                                    <p class="text-muted small mb-1">@activity.Description</p>
                                    <small class="text-muted">@activity.Timestamp.ToString("MMM dd, yyyy 'at' HH:mm")</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<!-- CTA Section -->
<section class="py-5 bg-primary text-white">
    <div class="container text-center">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-5 fw-bold mb-4">Ready to Transform Your Blogging?</h2>
                <p class="lead mb-4">
                    Join thousands of content creators who are already using BloggingAgent to create better content faster.
                </p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    @if (!Model.IsAuthenticated)
                    {
                        <a href="/Auth/Register" class="btn btn-light btn-lg px-4">
                            <i class="fas fa-user-plus me-2"></i>Start Free Trial
                        </a>
                        <a href="/Features" class="btn btn-outline-light btn-lg px-4">
                            <i class="fas fa-info-circle me-2"></i>Learn More
                        </a>
                    }
                    else
                    {
                        <a href="/Blog/Generate" class="btn btn-light btn-lg px-4">
                            <i class="fas fa-plus-circle me-2"></i>Create Your First Post
                        </a>
                        <a href="/Analytics" class="btn btn-outline-light btn-lg px-4">
                            <i class="fas fa-chart-line me-2"></i>View Dashboard
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Animate elements on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate-in');
                }
            });
        }, observerOptions);

        // Observe feature cards and stat cards
        document.querySelectorAll('.feature-card, .stat-card').forEach(card => {
            observer.observe(card);
        });
    </script>
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 70vh;
        display: flex;
        align-items: center;
    }

    .hero-robot {
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
    }

    .stat-card, .feature-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        opacity: 0;
        transform: translateY(20px);
    }

    .stat-card:hover, .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
    }

    .stat-card.animate-in, .feature-card.animate-in {
        opacity: 1;
        transform: translateY(0);
    }

    .category-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .category-card:hover {
        background-color: #f8f9fa;
        transform: translateY(-2px);
    }

    .activity-timeline {
        position: relative;
    }

    .activity-timeline::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e9ecef;
    }

    .activity-icon {
        position: relative;
        z-index: 1;
    }

    .activity-item:last-child .activity-icon::before {
        display: none;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
</style>
