                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-cog fa-4x text-info mb-3"></i>
                            <h5 class="card-title">Settings</h5>
                            <p class="card-text text-muted">Customize your blogging experience</p>
                            <a href="@Url.Action("Index", "Settings")" class="btn btn-info">
                                <i class="fas fa-cog me-2"></i>Configure
                            </a>
