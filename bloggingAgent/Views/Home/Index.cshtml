@{
    ViewData["Title"] = "Home";
}

<div class="hero-section bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">
                    Welcome to <span class="text-warning">BloggingAgent</span>
                </h1>
                <p class="lead mb-4">
                    The AI-powered blogging platform that transforms your ideas into engaging content.
                    Generate high-quality blog posts, optimize for SEO, and reach your audience across multiple channels.
                </p>
                <div class="d-flex gap-3">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="@Url.Action("Generate", "Blog")" class="btn btn-light btn-lg">
                            <i class="fas fa-magic me-2"></i>Create New Post
                        </a>
                        <a href="@Url.Action("Index", "Blog")" class="btn btn-outline-light btn-lg">
                            <i class="fas fa-blog me-2"></i>View Blog
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Register", "Account")" class="btn btn-light btn-lg">
                            <i class="fas fa-user-plus me-2"></i>Get Started
                        </a>
                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-light btn-lg">
                            <i class="fas fa-sign-in-alt me-2"></i>Sign In
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="text-center">
                    <i class="fas fa-robot fa-5x text-warning mb-3"></i>
                    <p class="h5">Powered by Advanced AI</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="features-section py-5 bg-light">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-12">
                <h2 class="display-5 fw-bold mb-3">Powerful Features</h2>
                <p class="lead text-muted">Everything you need to create, optimize, and grow your blog</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-brain fa-3x text-primary"></i>
                        </div>
                        <h5 class="card-title fw-bold">AI Content Generation</h5>
                        <p class="card-text text-muted">
                            Generate high-quality blog posts using advanced AI models like GPT and Ollama.
                            Create engaging content in minutes, not hours.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-search-plus fa-3x text-success"></i>
                        </div>
                        <h5 class="card-title fw-bold">SEO Optimization</h5>
                        <p class="card-text text-muted">
                            Automatically optimize your content for search engines with keyword analysis,
                            meta descriptions, and SEO recommendations.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-chart-line fa-3x text-info"></i>
                        </div>
                        <h5 class="card-title fw-bold">Analytics Dashboard</h5>
                        <p class="card-text text-muted">
                            Track your blog's performance with detailed analytics including views,
                            engagement metrics, and content performance insights.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-share-alt fa-3x text-warning"></i>
                        </div>
                        <h5 class="card-title fw-bold">Social Media Integration</h5>
                        <p class="card-text text-muted">
                            Automatically share your posts across Twitter, LinkedIn, and Facebook.
                            Grow your audience and increase engagement.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-users fa-3x text-danger"></i>
                        </div>
                        <h5 class="card-title fw-bold">Community Features</h5>
                        <p class="card-text text-muted">
                            Build a community around your content with comments, user profiles,
                            and interactive discussions.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-shield-alt fa-3x text-secondary"></i>
                        </div>
                        <h5 class="card-title fw-bold">Enterprise Security</h5>
                        <p class="card-text text-muted">
                            Bank-level security with ASP.NET Core Identity, JWT tokens,
                            and comprehensive authentication and authorization.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

