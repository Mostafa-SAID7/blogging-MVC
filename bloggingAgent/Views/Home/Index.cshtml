                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-chart-bar fa-4x text-success mb-3"></i>
                            <h5 class="card-title">View Analytics</h5>
                            <p class="card-text text-muted">Track your blog's performance and growth</p>
                            <a href="@Url.Action("Index", "Analytics")" class="btn btn-success">
                                <i class="fas fa-chart-bar me-2"></i>View Stats
