        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-md-6 col-lg-3">
                <div class="team-card text-center p-4 bg-white rounded-3 shadow-sm">
                    <div class="team-avatar mb-3">
                        <i class="fas fa-user-circle fa-4x text-primary"></i>
                    </div>
                    <h6 class="fw-bold mb-1">AI Research Lead</h6>
                    <p class="text-muted small mb-2">Machine Learning & NLP Expert</p>
                    <div class="social-links">
                        <a href="#" class="text-muted me-2"><i class="fab fa-linkedin"></i></a>
                        <a href="#" class="text-muted"><i class="fab fa-twitter"></i></a>
