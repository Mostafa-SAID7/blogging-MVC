                    <div class="social-links">
                        <a href="#" class="text-muted me-2"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-muted"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="team-card text-center p-4 bg-white rounded-3 shadow-sm">
                    <div class="team-avatar mb-3">
                        <i class="fas fa-user-circle fa-4x text-warning"></i>
                    </div>
                    <h6 class="fw-bold mb-1">UX Designer</h6>
                    <p class="text-muted small mb-2">User Experience & Design Expert</p>
                    <div class="social-links">
                        <a href="#" class="text-muted me-2"><i class="fab fa-dribbble"></i></a>
                        <a href="#" class="text-muted"><i class="fab fa-behance"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
