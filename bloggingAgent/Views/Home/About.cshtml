@model AboutViewModel
@{
    ViewData["Title"] = "About";
}

<!-- Hero Section -->
<section class="hero-section bg-gradient-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">About @Model.PlatformName</h1>
                <p class="lead mb-4">@Model.Description</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/Features" class="btn btn-light btn-lg px-4">
                        <i class="fas fa-star me-2"></i>Explore Features
                    </a>
                    <a href="/Contact" class="btn btn-outline-light btn-lg px-4">
                        <i class="fas fa-envelope me-2"></i>Contact Us
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="about-illustration">
                    <i class="fas fa-brain fa-10x text-warning opacity-75"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission Section -->
<section class="py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-5 fw-bold mb-3">Our Mission</h2>
                <p class="lead text-muted">
                    To democratize content creation by providing creators with powerful AI tools
                    that enhance creativity, improve efficiency, and maximize reach.
                </p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="mission-card text-center p-4 h-100">
                    <div class="mission-icon mb-3">
                        <i class="fas fa-lightbulb fa-3x text-primary"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Empower Creators</h5>
                    <p class="text-muted">
                        Give content creators the tools they need to focus on what matters most -
                        creating amazing content that resonates with their audience.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="mission-card text-center p-4 h-100">
                    <div class="mission-icon mb-3">
                        <i class="fas fa-rocket fa-3x text-success"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Accelerate Growth</h5>
                    <p class="text-muted">
                        Help creators grow their audience and impact through intelligent
                        content optimization and strategic publishing tools.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="mission-card text-center p-4 h-100">
                    <div class="mission-icon mb-3">
                        <i class="fas fa-globe fa-3x text-info"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Expand Reach</h5>
                    <p class="text-muted">
                        Enable creators to reach global audiences through multi-platform
                        publishing and advanced SEO optimization.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-5 fw-bold mb-3">What We Offer</h2>
                <p class="lead text-muted">
                    A comprehensive suite of AI-powered tools designed for modern content creators.
                </p>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var feature in Model.Features)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="feature-item d-flex align-items-center p-3 border rounded-3 bg-white shadow-sm">
                        <div class="feature-check me-3">
                            <i class="fas fa-check-circle text-success fa-lg"></i>
                        </div>
                        <div class="feature-text">
                            <span class="fw-medium">@feature</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Technology Stack Section -->
<section class="py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-5 fw-bold mb-3">Built with Modern Technology</h2>
                <p class="lead text-muted">
                    Leveraging the latest technologies to deliver a robust, scalable, and secure platform.
                </p>
            </div>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var tech in Model.Technologies)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="tech-card text-center p-4 border rounded-3 shadow-sm">
                        <div class="tech-icon mb-3">
                            @switch (tech.ToLower())
                            {
                                case "asp.net core 9.0":
                                    <i class="fab fa-microsoft fa-3x text-primary"></i>
                                    break;
                                case "entity framework core":
                                    <i class="fas fa-database fa-3x text-success"></i>
                                    break;
                                case "sql server":
                                    <i class="fas fa-server fa-3x text-info"></i>
                                    break;
                                case "openai gpt":
                                    <i class="fas fa-brain fa-3x text-warning"></i>
                                    break;
                                case "react.js":
                                    <i class="fab fa-react fa-3x text-info"></i>
                                    break;
                                case "bootstrap 5":
                                    <i class="fab fa-bootstrap fa-3x text-primary"></i>
                                    break;
                                case "docker":
                                    <i class="fab fa-docker fa-3x text-info"></i>
                                    break;
                                default:
                                    <i class="fas fa-code fa-3x text-secondary"></i>
                                    break;
                            }
                        </div>
                        <h6 class="fw-bold mb-2">@tech</h6>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
