                <div class="stat-large">
                    <h3 class="display-4 fw-bold mb-2">500+</h3>
                    <p class="mb-0">Active Creators</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-large">
                    <h3 class="display-4 fw-bold mb-2">95%</h3>
                    <p class="mb-0">User Satisfaction</p>
                </div>
            </div>
            <div class="col-md-3">
