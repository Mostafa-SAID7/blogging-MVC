# BloggingAgent Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (for PostgreSQL if using instead of SQLite)
POSTGRES_PASSWORD=your_secure_postgres_password

# Redis Configuration (if using Redis for caching)
REDIS_URL=redis://localhost:6379

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# Logging
LOG_LEVEL=Information
LOG_FILE_PATH=/app/logs/bloggingagent.log

# Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY_HOURS=24

# Email Configuration (for future features)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Analytics
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
MIXPANEL_TOKEN=your_mixpanel_token

# External APIs
NEWS_API_KEY=your_news_api_key
SOCIAL_MEDIA_API_KEY=your_social_media_api_key

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=200

# Cache Settings
CACHE_EXPIRATION_MINUTES=30
ENABLE_DISTRIBUTED_CACHE=false

# AI Model Settings
OLLAMA_MODEL=llama2
OPENAI_MODEL=gpt-3.5-turbo
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000

# SEO Settings
SEO_TITLE_MIN_LENGTH=30
SEO_TITLE_MAX_LENGTH=60
SEO_DESCRIPTION_MIN_LENGTH=120
SEO_DESCRIPTION_MAX_LENGTH=160

# Content Settings
DEFAULT_AUTHOR=AI Assistant
MAX_POST_LENGTH=5000
AUTO_PUBLISH=false

# Backup Settings
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/backups

# Monitoring
HEALTH_CHECK_INTERVAL_SECONDS=30
METRICS_ENABLED=true
METRICS_PORT=9090